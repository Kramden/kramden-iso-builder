#!/bin/bash
# Copy to env.sh (kept out of git — contains credentials) and fill in real
# values. Sourced by run_fog_auto_deploy.sh before invoking fog_auto_deploy.py,
# so every variable must be `export`ed to reach the python subprocess.

# --- Required ---

# GitHub token with read access to Kramden/kramden-iso-builder, used to look
# up the latest successful build-image.yaml run and download its artifact.
export GH_TOKEN="your_github_read_only_token"

# FOG's global API token (Configuration > User Management > API in the FOG UI).
export FOG_API_TOKEN="your_global_token"

# FOG user token for the API user (same location as above).
export FOG_USER_TOKEN="your_user_token"

# Base URL of the FOG server, without a trailing /management.
export FOG_URL="http://your-fog-ip/fog"

# MAC address of the Proxmox VM's NIC, used to match it to a FOG host record.
export VM_MAC="AA:BB:CC:DD:EE:FF"

# --- Optional (defaults shown) ---

# Proxmox VM ID used as the capture/deploy target.
# export VM_ID="999"

# Proxmox storage to import the downloaded qcow2 into.
# export STORAGE="DRIVE-ZFS"

# Disk slot the imported image is attached to. Must match the VM's boot disk.
# export DISK_SLOT="scsi0"

# Boot order set on the VM after import. Must PXE-boot first (net0) so FOS
# loads and captures the freshly imported disk.
# export BOOT_ORDER="net0;${DISK_SLOT:-scsi0}"

# Reuse an existing FOG image ID instead of creating a new image record each
# run. Leave unset to create a new image record on every run.
# export IMAGE_ID=""
